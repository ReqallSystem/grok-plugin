{
  "description": "Reqall context retrieval and persistence for Grok Build.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/scripts/reqall-hook.mjs\"",
            "timeout": 20,
            "statusMessage": "Initializing Reqall memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/scripts/reqall-hook.mjs\"",
            "timeout": 20,
            "statusMessage": "Retrieving Reqall context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|search_replace|Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/scripts/reqall-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking Reqall path context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|search_replace|Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/scripts/reqall-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Noting work for Reqall"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/scripts/reqall-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "Verifying Reqall persistence"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "Plan|plan",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/scripts/reqall-hook.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/scripts/reqall-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
